+    // Initialise last_action / processed targets so they match the current joint positions
+    // (otherwise the policy starts from last_action = 0 while the legs are elsewhere -> start-up kick).
+    void warm_start(const std::vector<float>& joint_pos)
+    {
+        std::vector<float> raw;
+        int idx = 0;
+        for(auto & term : _terms)
+        {
+            std::vector<float> q(joint_pos.begin() + idx, joint_pos.begin() + std::min<int>(joint_pos.size(), idx + term->action_dim()));
+            auto r = term->inverse_actions(q);
+            raw.insert(raw.end(), r.begin(), r.end());
+            idx += term->action_dim();
+        }
+        process_action(raw);
+    }
