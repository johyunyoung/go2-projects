+    // raw action that would reproduce the given joint targets: (q - offset) / scale
+    std::vector<float> inverse_actions(const std::vector<float>& q) override
+    {
+        std::vector<float> raw(_action_dim, 0.0f);
+        for(int i(0); i<_action_dim && i<(int)q.size(); ++i)
+        {
+            raw[i] = _scale[i] != 0.0f ? (q[i] - _offset[i]) / _scale[i] : 0.0f;
+        }
+        return raw;
+    }
