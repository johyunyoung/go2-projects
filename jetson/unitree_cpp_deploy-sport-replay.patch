         ts_ = cfg["ts"].as<std::vector<float>>();
         qs_ = cfg["qs"].as<std::vector<std::vector<float>>>();
         assert(ts_.size() == qs_.size());
+        // optional (recorded sport-mode motions): feed-forward torque per keyframe, velocity target = keyframe slope,
+        // and kp/kd ramped from the previous state's gains instead of switched at once
+        if (cfg["taus"]) { taus_ = cfg["taus"].as<std::vector<std::vector<float>>>(); assert(taus_.size() == ts_.size()); }
+        if (cfg["velocity_ff"]) velocity_ff_ = cfg["velocity_ff"].as<bool>();
+        if (cfg["gain_ramp_s"]) gain_ramp_s_ = cfg["gain_ramp_s"].as<float>();
+        for (auto & tau : taus_) if (tau.empty()) tau.assign(kp_.size(), 0.0f);
 
         if(cfg["auto_transition"])
         {
@@ -45,11 +52,13 @@ public:
     void enter()
     {
         // set gain
+        kp0_.assign(kp_.size(), 0.0f); kd0_.assign(kd_.size(), 0.0f);
         for(int i(0); i < kp_.size(); ++i)
         {
             auto & motor = lowcmd->msg_.motor_cmd()[i];
-            motor.kp() = kp_[i];
-            motor.kd() = kd_[i];
+            kp0_[i] = motor.kp(); kd0_[i] = motor.kd();
+            if (!taus_.empty()) taus_[0][i] = motor.tau();   // keyframe 0 = the torque commanded at entry (like qs_[0] below)
+            if (gain_ramp_s_ <= 0.0f) { motor.kp() = kp_[i]; motor.kd() = kd_[i]; }
             motor.dq() = motor.tau() = 0;
         }
 
@@ -71,6 +80,26 @@ public:
         for(int i(0); i < q.size(); ++i) {
             lowcmd->msg_.motor_cmd()[i].q() = q[i];
         }
+
+        if (gain_ramp_s_ > 0.0f) {
+            const float r = std::min(1.0f, t / gain_ramp_s_);
+            for (int i(0); i < kp_.size(); ++i) {
+                lowcmd->msg_.motor_cmd()[i].kp() = kp0_[i] + r * (kp_[i] - kp0_[i]);
+                lowcmd->msg_.motor_cmd()[i].kd() = kd0_[i] + r * (kd_[i] - kd0_[i]);
+            }
+        }
+        if (!taus_.empty()) {
+            auto tau = linear_interpolate(t, ts_, taus_);
+            for (int i(0); i < tau.size(); ++i) lowcmd->msg_.motor_cmd()[i].tau() = tau[i];
+        }
+        if (velocity_ff_) {
+            int k = 0;   // segment [ts_[k], ts_[k+1]) containing t; zero velocity before the first / after the last keyframe
+            while (k + 1 < ts_.size() && ts_[k + 1] <= t) ++k;
+            const bool inside = t >= ts_.front() && k + 1 < ts_.size();
+            const float seg = inside ? ts_[k + 1] - ts_[k] : 0.0f;   // guard: duplicate timestamps in the config
+            for (int i(0); i < q.size(); ++i)
+                lowcmd->msg_.motor_cmd()[i].dq() = seg > 1e-6f ? (qs_[k + 1][i] - qs_[k][i]) / seg : 0.0f;
+        }
     }
 
