     std::vector<float> kd_;
     std::vector<float> ts_;
     std::vector<std::vector<float>> qs_;
+    std::vector<std::vector<float>> taus_;
+    bool velocity_ff_ = false;
+    float gain_ramp_s_ = 0.0f;
+    std::vector<float> kp0_, kd0_;
 };
 
