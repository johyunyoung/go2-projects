+    void configure_heading_hold(const YAML::Node& fsm_cfg)
+    {
+        heading_hold_enabled_ = false;
+        if (!fsm_cfg || !fsm_cfg["heading_hold"]) return;
+        const auto hh = fsm_cfg["heading_hold"];
+        heading_hold_enabled_ = hh["enabled"].as<bool>(false);
