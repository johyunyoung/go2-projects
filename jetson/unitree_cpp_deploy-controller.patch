+
+    void apply_heading_hold(bool use_fixed_command)
+    {
+        if (!heading_hold_enabled_ || !std::isfinite(current_yaw_)) return;
+        const float stick = (joystick_ != nullptr) ? std::fabs(joystick_->rx()) : 0.0f;
+        const bool turn_requested = use_fixed_command ? (std::fabs(command_[2]) > 1e-6f) : (stick >= heading_deadzone_);
+        if (turn_requested) { heading_holding_ = false; return; }
+        if (!heading_holding_) { heading_yaw_ref_ = current_yaw_; heading_holding_ = true; }
+        float err = heading_yaw_ref_ - current_yaw_;
+        err = std::atan2(std::sin(err), std::cos(err));
+        command_[2] = std::clamp(heading_kp_ * err, -heading_max_rate_, heading_max_rate_);
+    }
