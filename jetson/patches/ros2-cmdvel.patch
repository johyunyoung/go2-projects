-    void apply_heading_hold(bool use_fixed_command)
+    // ROS 2 /cmd_vel (FSM cfg key cmd_vel): used instead of the sticks while messages keep arriving.
+    //   enabled: false          default: off, original behaviour
+    //   topic: rt/cmd_vel       DDS topic name; ROS 2 topic /cmd_vel maps to rt/cmd_vel
+    //   timeout_s: 0.5          a message older than this is ignored -> joystick (normally zero) again
+    //   stick_override: 0.1     any stick deflected beyond this -> joystick wins while deflected
+    void configure_cmd_vel(const YAML::Node& fsm_cfg)
+    {
+        cmd_vel_enabled_ = false;
+        cmd_vel_active_ = false;
+        if (!fsm_cfg || !fsm_cfg["cmd_vel"]) return;
+        const auto cv = fsm_cfg["cmd_vel"];
+        cmd_vel_enabled_ = cv["enabled"].as<bool>(false);
+        if (!cmd_vel_enabled_) return;
+        const std::string topic = cv["topic"].as<std::string>("rt/cmd_vel");
+        cmd_vel_timeout_s_ = cv["timeout_s"].as<float>(0.5f);
+        cmd_vel_stick_override_ = cv["stick_override"].as<float>(0.1f);
+        if (!std::isfinite(cmd_vel_timeout_s_) || cmd_vel_timeout_s_ <= 0.0f) {
+            throw std::invalid_argument("cmd_vel.timeout_s must be finite and positive");
+        }
+        if (joystick_ == nullptr) {
+            throw std::invalid_argument("cmd_vel requires a joystick (stick override)");
+        }
+        CmdVelSource::instance().start(topic);
+        spdlog::info("cmd_vel enabled: topic '{}' timeout {:.2f} s, stick override {:.2f}; commands clipped to the policy ranges",
+            topic, cmd_vel_timeout_s_, cmd_vel_stick_override_);
+    }
+
+    bool joystick_deflected() const
+    {
+        if (joystick_ == nullptr) return false;
+        return std::fabs(joystick_->lx()) >= cmd_vel_stick_override_
+            || std::fabs(joystick_->ly()) >= cmd_vel_stick_override_
+            || std::fabs(joystick_->rx()) >= cmd_vel_stick_override_;
