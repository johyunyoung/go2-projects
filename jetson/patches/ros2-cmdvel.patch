+++ b/deploy/include/utils/CmdVelSource.h
@@ -0,0 +1,117 @@
+// ROS 2 /cmd_vel source for the velocity command (go2-projects jetson/patches/ros2-cmdvel.patch).
+//
+// A ROS 2 node (rmw_cyclonedds, same DDS domain and network interface as go2_ctrl) publishing
+// geometry_msgs/msg/Twist on /cmd_vel appears on the wire as DDS topic "rt/cmd_vel" with type
+// "geometry_msgs::msg::dds_::Twist_". unitree_sdk2 ships exactly that IDL type, so the controller
+// can subscribe with the plain ChannelSubscriber and no rclcpp is linked into go2_ctrl.
+//
+// Safety: a message is only used while it is younger than the timeout (default 0.5 s), so a
+// stalled or killed ROS 2 node makes the command fall back to the joystick (normally zero -> the
+// policy stops in place). Non-finite values are dropped. FSM transitions (stand up, start,
+// emergency stop) remain remote-controller only.
+
+#pragma once
+
+#include <unitree/robot/channel/channel_subscriber.hpp>
+#include <unitree/idl/ros2/Twist_.hpp>
+#include <spdlog/spdlog.h>
+
+#include <array>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <string>
+
+namespace utils
+{
+
+class CmdVelSource
+{
+public:
+    using Twist = geometry_msgs::msg::dds_::Twist_;
+
+    // One DDS reader per process, shared by every FSM state that enables cmd_vel.
+    static CmdVelSource& instance()
+    {
+        static CmdVelSource s;
+        return s;
+    }
+
+    // Idempotent. ChannelFactory::Init must already have been called (main.cpp does that first).
+    void start(const std::string& topic)
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (sub_) {
+            if (topic != topic_) {
+                spdlog::warn("cmd_vel: already subscribed to '{}', ignoring request for '{}'", topic_, topic);
+            }
+            return;
+        }
+        topic_ = topic;
+        sub_ = std::make_shared<unitree::robot::ChannelSubscriber<Twist>>(topic_);
+        sub_->InitChannel([this](const void* msg) { on_message(*static_cast<const Twist*>(msg)); });  // same default queue as the SDK wrappers
+        spdlog::info("cmd_vel: subscribed to DDS topic '{}' (ROS 2 geometry_msgs/Twist)", topic_);
+    }
+
+    bool started() const
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return static_cast<bool>(sub_);
+    }
+
+    // Latest (vx, vy, wz) if a message arrived within max_age_s; false otherwise.
+    bool get(std::array<float, 3>& cmd, float max_age_s) const
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!has_msg_) return false;
+        const float age = std::chrono::duration<float>(std::chrono::steady_clock::now() - last_rx_).count();
+        if (age > max_age_s) return false;
+        cmd = cmd_;
+        return true;
+    }
+
+    uint64_t count() const
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return count_;
+    }
+
+private:
+    CmdVelSource() = default;
+
+    void on_message(const Twist& t)
+    {
+        const std::array<float, 3> v{
+            static_cast<float>(t.linear().x()),
+            static_cast<float>(t.linear().y()),
+            static_cast<float>(t.angular().z())};
+        for (float x : v) {
+            if (!std::isfinite(x)) {
+                std::lock_guard<std::mutex> lock(mutex_);
+                ++dropped_;
+                if (dropped_ == 1 || dropped_ % 100 == 0) {
+                    spdlog::warn("cmd_vel: dropped {} message(s) with non-finite values", dropped_);
+                }
+                return;
+            }
+        }
+        std::lock_guard<std::mutex> lock(mutex_);
+        cmd_ = v;
+        last_rx_ = std::chrono::steady_clock::now();
+        has_msg_ = true;
+        ++count_;
+    }
+
+    mutable std::mutex mutex_;
+    std::string topic_;
+    std::shared_ptr<unitree::robot::ChannelSubscriber<Twist>> sub_;
+    std::array<float, 3> cmd_{0.0f, 0.0f, 0.0f};
+    std::chrono::steady_clock::time_point last_rx_;
+    bool has_msg_ = false;
+    uint64_t count_ = 0;
+    uint64_t dropped_ = 0;
+};
+
+} // namespace utils
