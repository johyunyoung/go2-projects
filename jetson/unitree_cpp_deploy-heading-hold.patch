+    // Heading hold: while the yaw stick is inside the deadzone, command wz = kp * wrap(yaw_ref - yaw)
+    // so a learned yaw bias does not curve the path (sport-mode-like behaviour).
+    void configure_heading_hold(const YAML::Node& fsm_cfg)
+    {
+        heading_hold_enabled_ = false;
+        if (!fsm_cfg || !fsm_cfg["heading_hold"]) return;
+        const auto hh = fsm_cfg["heading_hold"];
+        heading_hold_enabled_ = hh["enabled"].as<bool>(false);
+        heading_kp_ = hh["kp"].as<float>(1.0f);
+        heading_max_rate_ = hh["max_rate"].as<float>(0.6f);
+        heading_deadzone_ = hh["deadzone"].as<float>(0.05f);
+        if (heading_hold_enabled_) {
+            spdlog::info("Heading hold enabled: kp={:.2f} max_rate={:.2f} rad/s deadzone={:.2f}", heading_kp_, heading_max_rate_, heading_deadzone_);
+        }
+    }
+
+    void apply_heading_hold(bool use_fixed_command)
+    {
+        if (!heading_hold_enabled_ || !std::isfinite(current_yaw_)) return;
+        const float stick = (joystick_ != nullptr) ? std::fabs(joystick_->rx()) : 0.0f;
+        const bool turn_requested = use_fixed_command ? (std::fabs(command_[2]) > 1e-6f) : (stick >= heading_deadzone_);
+        if (turn_requested) { heading_holding_ = false; return; }
+        if (!heading_holding_) { heading_yaw_ref_ = current_yaw_; heading_holding_ = true; }
+        float err = heading_yaw_ref_ - current_yaw_;
+        err = std::atan2(std::sin(err), std::cos(err));
+        command_[2] = std::clamp(heading_kp_ * err, -heading_max_rate_, heading_max_rate_);
+    }
