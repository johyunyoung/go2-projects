diff --git a/deploy/robots/go2/main.cpp b/deploy/robots/go2/main.cpp
index 03aeac6..543dde4 100644
--- a/deploy/robots/go2/main.cpp
+++ b/deploy/robots/go2/main.cpp
@@ -3,10 +3,211 @@
 #include "FSM/State_Fix.h"
 #include "FSM/State_RLBase.h"
 
+#include <algorithm>
+#include <chrono>
+#include <cstdlib>
+#include <fstream>
+#include <thread>
+
 std::unique_ptr<LowCmd_t> FSMState::lowcmd = nullptr;
 std::shared_ptr<LowState_t> FSMState::lowstate = nullptr;
 std::shared_ptr<Keyboard> FSMState::keyboard = nullptr;
 
+using SteadyClock = std::chrono::steady_clock;
+using MotionSwitcher = unitree::robot::b2::MotionSwitcherClient;
+
+/* ---------- sport mode (Unitree high-level controller) helpers ---------- */
+
+// Kernel uptime. Inside the container this is the Jetson host uptime.
+static double host_uptime_s()
+{
+    std::ifstream f("/proc/uptime");
+    double up = 1e9;
+    f >> up;
+    return up;
+}
+
+// Ask the motion switcher which high-level mode is active ("" = none). False if the service did not answer.
+static bool query_sport_mode(MotionSwitcher& msc, std::string& name)
+{
+    std::string form;
+    name.clear();
+    return msc.CheckMode(form, name) == 0;
+}
+
+// Release sport mode and return only once the motion switcher confirms that no mode is active.
+// Never returns with sport mode still active: gives up (exit 4) instead of sharing the motors.
+static void release_sport_mode_confirmed(MotionSwitcher& msc)
+{
+    std::string name;
+    for (int attempt = 1; attempt <= 60; ++attempt)
+    {
+        if (!query_sport_mode(msc, name))
+        {
+            spdlog::warn("Sport mode: motion switcher did not answer (attempt {}), retrying", attempt);
+            usleep(500000);
+            continue;
+        }
+        if (name.empty())
+        {
+            spdlog::info("Sport mode: off (confirmed by motion switcher).");
+            return;
+        }
+        spdlog::info("Sport mode: releasing '{}' (attempt {})", name, attempt);
+        msc.ReleaseMode();
+        usleep(500000);
+    }
+    spdlog::critical("Sport mode: could not confirm release after 60 attempts. Not taking over the motors.");
+    spdlog::default_logger()->flush();
+    std::_Exit(4);
+}
+
+/*
+ * Handover gate (config.yaml top-level key `handover`), for starting this controller at boot.
+ * Only rt/lowstate is read here; no motor command is sent until sport mode is confirmed off.
+ *   handover:
+ *     enabled: true
+ *     keys: ""                # "" = take over automatically; or a joystick DSL combo, e.g. "LB(2s) + RB(2s)"
+ *     lying_calf_max: -2.3    # all four calf angles must be below this [rad] (robot lying down)
+ *     lying_hold_s: 1.0       # ... continuously for this long (not mid stand-up / lie-down)
+ *     boot_window_s: 180      # if the host booted less than this ago, wait for sport mode to appear first,
+ *                             # so it is released instead of starting later and fighting over the motors
+ *     sport_settle_s: 5       # after sport mode appears, let it finish what it does (e.g. stand up) first
+ * Without the key (or enabled: false) the controller behaves as before.
+ */
+void wait_for_handover()
+{
+    const auto cfg = param::config["handover"];
+    if (!cfg || !cfg["enabled"] || !cfg["enabled"].as<bool>()) return;
+
+    const std::string keys = cfg["keys"] ? cfg["keys"].as<std::string>() : "";
+    const float lying_calf_max = cfg["lying_calf_max"] ? cfg["lying_calf_max"].as<float>() : -2.3f;
+    const float lying_hold_s = cfg["lying_hold_s"] ? cfg["lying_hold_s"].as<float>() : 1.0f;
+    const double boot_window_s = cfg["boot_window_s"] ? cfg["boot_window_s"].as<double>() : 180.0;
+    const double sport_settle_s = cfg["sport_settle_s"] ? cfg["sport_settle_s"].as<double>() : 5.0;
+    std::function<bool(const unitree::common::UnitreeJoystick&)> combo =
+        [](const unitree::common::UnitreeJoystick&) { return true; };
+    if (!keys.empty())
+    {
+        unitree::common::dsl::Parser parser(keys);
+        auto ast = parser.Parse();
+        combo = unitree::common::dsl::Compile(*ast);
+    }
+
+    auto state = std::make_shared<LowState_t>();
+    spdlog::info("Handover: waiting for robot state...");
+    state->wait_for_connection();
+
+    // 1. the motion switcher service must answer, otherwise we cannot know whether sport mode runs
+    MotionSwitcher msc;
+    msc.SetTimeout(2.0f);
+    msc.Init();
+    std::string mode;
+    auto last_msg = SteadyClock::now();
+    while (!query_sport_mode(msc, mode))
+    {
+        if (SteadyClock::now() - last_msg > std::chrono::seconds(10))
+        {
+            spdlog::info("Handover: waiting for the motion switcher service to answer...");
+            last_msg = SteadyClock::now();
+        }
+        usleep(500000);
+    }
+    spdlog::info("Handover: motion switcher answers, active mode '{}'.", mode);
+
+    // 2. just after boot sport mode may not be running yet: wait for it instead of racing it
+    if (mode.empty() && host_uptime_s() < boot_window_s)
+    {
+        spdlog::info("Handover: host booted {:.0f} s ago. Waiting for sport mode to start (until {:.0f} s) "
+                     "so it can be released before taking over.", host_uptime_s(), boot_window_s);
+        while (mode.empty() && host_uptime_s() < boot_window_s)
+        {
+            usleep(500000);
+            query_sport_mode(msc, mode);
+        }
+        if (mode.empty())
+            spdlog::warn("Handover: sport mode did not appear within the boot window. Continuing; the guard stays active.");
+    }
+    if (!mode.empty())
+    {
+        spdlog::info("Handover: sport mode '{}' is running. Letting it settle for {:.0f} s.", mode, sport_settle_s);
+        usleep(static_cast<useconds_t>(sport_settle_s * 1e6));
+    }
+
+    if (keys.empty())
+        spdlog::info("Handover: automatic. Taking over once the robot has been lying for {:.1f} s "
+                     "(if sport mode stood it up: sport mode L2+A twice to lie down).", lying_hold_s);
+    else
+        spdlog::info("Handover: sport mode keeps control. Lay the robot down (sport mode L2+A twice), "
+                     "then hold [{}] to switch to this controller.", keys);
+
+    // 3. robot lying (stable) [+ combo]
+    last_msg = SteadyClock::now() - std::chrono::seconds(60);
+    auto lying_since = SteadyClock::now();
+    bool was_lying = false;
+    while (true)
+    {
+        state->update();
+        const auto now = SteadyClock::now();
+        float calf_max = -10.0f;
+        for (int i : {2, 5, 8, 11}) calf_max = std::max(calf_max, static_cast<float>(state->msg_.motor_state()[i].q()));
+        const bool lying = calf_max < lying_calf_max;
+        if (lying && !was_lying) lying_since = now;
+        was_lying = lying;
+        const bool lying_stable = lying && std::chrono::duration<float>(now - lying_since).count() >= lying_hold_s;
+
+        if (combo(state->joystick))
+        {
+            if (lying_stable)
+            {
+                spdlog::info("Handover: robot is lying (max calf {:.2f} rad).", calf_max);
+                break;
+            }
+            if (now - last_msg > std::chrono::seconds(keys.empty() ? 10 : 2))
+            {
+                if (keys.empty())
+                    spdlog::info("Handover: waiting for the robot to lie down (max calf {:.2f} rad, need < {:.2f}).",
+                                 calf_max, lying_calf_max);
+                else
+                    spdlog::warn("Handover refused: robot is not lying (max calf {:.2f} rad, need < {:.2f}). Lay it down first.",
+                                 calf_max, lying_calf_max);
+                last_msg = now;
+            }
+        }
+        usleep(20000);
+    }
+
+    // 4. release sport mode and confirm before any motor command is sent
+    release_sport_mode_confirmed(msc);
+}
+
+/*
+ * Guard: while this controller runs, sport mode must stay off. If it becomes active (e.g. it started late),
+ * both would command the motors. Force Passive (damping), release sport mode, then exit so the service
+ * restarts the controller cleanly through the handover gate.
+ */
+void start_sport_mode_guard()
+{
+    std::thread([] {
+        MotionSwitcher msc;
+        msc.SetTimeout(2.0f);
+        msc.Init();
+        std::string name;
+        while (true)
+        {
+            sleep(1);
+            if (!query_sport_mode(msc, name) || name.empty()) continue;
+            spdlog::critical("Guard: sport mode '{}' became active while this controller runs. Forcing Passive.", name);
+            FSMState::force_passive = true;
+            release_sport_mode_confirmed(msc);
+            spdlog::critical("Guard: sport mode released. Exiting in 2 s; the service restarts the controller.");
+            spdlog::default_logger()->flush();
+            sleep(2);
+            std::_Exit(3);
+        }
+    }).detach();
+}
