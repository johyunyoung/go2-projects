# Docker Hub namespace for the redistributable deploy image.
DEPLOY_IMAGE=johyunyoung/go2-deploy
DEPLOY_TAG=latest

# Training image stays local: its base layer is NVIDIA's EULA-gated Isaac Sim.
ISAACLAB_IMAGE=go2-isaaclab
ISAACLAB_TAG=latest

ISAACSIM_BASE_IMAGE=nvcr.io/nvidia/isaac-sim
ISAACSIM_VERSION=5.1.0
ACCEPT_EULA=Y

# Host directory holding trained runs. A run directory needs params/deploy.yaml and
# exported/policy.onnx; POLICY_DIR may point either at one run or at a parent of runs.
POLICY_DIR=${HOME}/go2-policies

# DDS interface for go2_ctrl: lo against the simulator, the robot's NIC for real hardware.
DDS_INTERFACE=lo
